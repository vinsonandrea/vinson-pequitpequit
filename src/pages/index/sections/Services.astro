---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Services — Glimmer Fragrance Co.">
	<section class="section site-container">
		<div class="section-heading">
			<div class="section-label">Our Services</div>
			<h1>Made with Care</h1>
			<p>We use quality ingredients and careful handcrafting to make each fragrance.</p>
		</div>
		<div class="services-grid">
			<article><span>I</span><h2>Responsibly Sourced</h2><p>We work with growers who provide pure botanical oils.</p></article>
			<article><span>II</span><h2>Six-Week Rest</h2><p>Each batch rests for six weeks so the scents blend well.</p></article>
			<article><span>III</span><h2>Custom Blends</h2><p>Book a session to create a scent that is personal to you.</p></article>
		</div>
		<a class="button" href="/index/sections/Process">See Our Process</a>
	</section>
</BaseLayout>

<style>
	.section { padding: 100px 0; }
	.section-heading { max-width: 680px; margin-bottom: 45px; }
	.section-label { color: var(--accent); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; }
	h1 { font-family: "Playfair Display", Georgia, serif; font-size: clamp(2.8rem, 6vw, 5rem); margin: 18px 0; }
	.section-heading p { color: var(--muted); line-height: 1.9; }
	.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 40px; }
	article { padding: 32px; border: 1px solid var(--glass-border); border-radius: 20px; background: var(--glass-bg); }
	article span { color: var(--accent); font-size: 1.4rem; }
	h2 { font-family: "Playfair Display", Georgia, serif; }
	article p { color: var(--muted); line-height: 1.8; }
	@media (max-width: 990px) { .services-grid { grid-template-columns: 1fr; } }
</style>