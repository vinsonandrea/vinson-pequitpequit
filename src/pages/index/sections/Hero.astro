---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Glimmer Fragrance Co.">
	<section class="hero site-container">
		<div>
			<div class="section-label">Fine Fragrance</div>
			<h1>Scents Made for <em>Everyday</em> Moments.</h1>
			<p>Simple fragrances made with carefully chosen ingredients.</p>
			<a class="button" href="/index/sections/Projects">View Collection</a>
		</div>
		<img src="https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&q=80&w=1000" alt="Glimmer perfume bottle" />
	</section>
</BaseLayout>

<style>
	.hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 65px; min-height: 650px; padding-block: 80px; }
	.section-label { color: var(--accent); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; }
	h1 { margin: 18px 0; font-family: "Playfair Display", Georgia, serif; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 1.02; }
	h1 em { color: var(--accent); }
	p { margin-bottom: 30px; color: var(--muted); line-height: 1.9; }
	.hero img { width: 100%; height: 560px; border: 1px solid var(--border); border-radius: 200px 200px 24px 24px; object-fit: cover; }
	@media (max-width: 990px) { .hero { grid-template-columns: 1fr; } .hero img { height: 450px; } }
</style>