---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects — Glimmer Fragrance Co.">
	<section class="section site-container">
		<div class="section-label">Our Collection</div>
		<h1>Fragrances</h1>
		<p class="intro">Three scents made with concentrated oils and lasting notes.</p>
		<div class="menu-grid">
			<article>
				<img src="https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&q=80&w=800" alt="Aura Gold perfume" />
				<div><h2>Aura Gold</h2><span>$220</span><p>Amber, tonka bean, bergamot, and pink pepper.</p></div>
			</article>
			<article>
				<img src="https://images.unsplash.com/photo-1588405748880-12d1d2a59f75?auto=format&fit=crop&q=80&w=800" alt="Velvet Noir perfume" />
				<div><h2>Velvet Noir</h2><span>$245</span><p>Vetiver, cedarwood, and jasmine.</p></div>
			</article>
			<article>
				<img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&q=80&w=800" alt="Lumière Blanc perfume" />
				<div><h2>Lumière Blanc</h2><span>$210</span><p>White tea, pear blossom, and soft musk.</p></div>
			</article>
		</div>
	</section>
</BaseLayout>

<style>
	.section { padding: 100px 0; }
	.section-label { color: var(--accent); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; }
	h1 { margin: 18px 0 12px; font-family: "Playfair Display", Georgia, serif; font-size: clamp(2.8rem, 6vw, 5rem); }
	.intro { max-width: 620px; color: var(--muted); line-height: 1.9; }
	.menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 45px; }
	article { overflow: hidden; border: 1px solid var(--border); border-radius: 20px; background: var(--surface); }
	article img { width: 100%; height: 260px; object-fit: cover; }
	article div { padding: 24px; }
	h2 { display: inline-block; margin: 0; font-family: "Playfair Display", Georgia, serif; }
	article span { float: right; color: var(--accent); font-weight: 700; }
	article p { clear: both; padding-top: 12px; color: var(--muted); line-height: 1.7; }
	@media (max-width: 990px) { .menu-grid { grid-template-columns: 1fr; } }
</style>