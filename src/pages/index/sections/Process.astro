---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Process — Glimmer Fragrance Co.">
	<section class="section site-container">
		<div class="section-label">How We Make It</div>
		<h1>Our Process</h1>
		<div class="process-grid">
			<article><span>01</span><h2>Source</h2><p>We choose quality ingredients from trusted growers.</p></article>
			<article><span>02</span><h2>Blend</h2><p>We blend the ingredients around one main scent.</p></article>
			<article><span>03</span><h2>Rest</h2><p>Each blend rests for six weeks.</p></article>
			<article><span>04</span><h2>Bottle</h2><p>We bottle each finished fragrance by hand.</p></article>
		</div>
	</section>
</BaseLayout>

<style>
	.section { padding: 100px 0; }
	.section-label { color: var(--accent); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; }
	h1 { max-width: 700px; margin: 18px 0 45px; font-family: "Playfair Display", Georgia, serif; font-size: clamp(2.8rem, 6vw, 5rem); }
	.process-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
	article { min-height: 220px; padding: 32px; border: 1px solid var(--border); border-radius: 20px; background: var(--surface); }
	article span { color: var(--accent); font-weight: 700; }
	h2 { font-family: "Playfair Display", Georgia, serif; font-size: 1.8rem; }
	p { color: var(--muted); line-height: 1.8; }
	@media (max-width: 700px) { .process-grid { grid-template-columns: 1fr; } }
</style>